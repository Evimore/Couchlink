// Windows resources for inputline-host.exe: the InputLine icon, and the
// version details Windows shows (the description names the app on
// notifications).
#include <winver.h>

1 ICON "../../installer/windows/inputline.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION INPUTLINE_VERSION_MAJOR, INPUTLINE_VERSION_MINOR, INPUTLINE_VERSION_PATCH, 0
PRODUCTVERSION INPUTLINE_VERSION_MAJOR, INPUTLINE_VERSION_MINOR, INPUTLINE_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "InputLine"
      VALUE "ProductName", "InputLine"
      VALUE "InternalName", "inputline-host"
      VALUE "OriginalFilename", "inputline-host.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
