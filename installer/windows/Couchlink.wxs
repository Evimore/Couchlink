<!--
  Couchlink for Windows: installs couchlink-host as the "Couchlink" service.

  Build (WiX Toolset v5, see .github/workflows):
    wix build installer/windows/Couchlink.wxs -arch x64
      -ext WixToolset.Util.wixext -ext WixToolset.Firewall.wixext -ext WixToolset.UI.wixext
      -d Version=1.2.3 -d BinDir=build/host/Release -d RootDir=. -o Couchlink-Setup.msi

  Test installs without usbip-win2 (CI): msiexec /i Couchlink-Setup.msi SKIPUSBIPCHECK=1
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall">

  <!-- Never change the UpgradeCode: it is how new versions find and replace old ones. -->
  <Package Name="Couchlink"
           Manufacturer="Couchlink"
           Version="$(var.Version)"
           UpgradeCode="0643F26E-8FA2-4E37-A4C5-9B8B85E44937"
           Scope="perMachine"
           Language="1033">
    <SummaryInformation Description="Couchlink: Steam Controller with full Steam Input while streaming to iPad and iPhone" />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Couchlink is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="CouchlinkIcon" SourceFile="$(var.RootDir)\installer\windows\couchlink.ico" />
    <Property Id="ARPPRODUCTICON" Value="CouchlinkIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/orel-mor/Couchlink" />
    <Property Id="ARPHELPLINK" Value="https://github.com/orel-mor/Couchlink/blob/main/docs/host-setup-windows.md" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- usbip-win2 attaches the virtual controller; without it nothing reaches Steam. -->
    <Property Id="USBIPEXE">
      <DirectorySearch Id="UsbipFolder" Path="[ProgramFiles64Folder]USBip" Depth="0">
        <FileSearch Name="usbip.exe" />
      </DirectorySearch>
    </Property>
    <Launch Condition="Installed OR USBIPEXE OR SKIPUSBIPCHECK"
            Message="Couchlink needs usbip-win2, which plugs the virtual Steam Controller into Windows. Install it from https://github.com/vadimgrn/usbip-win2/releases, then run this installer again." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Couchlink">
        <Component Id="Host">
          <File Id="HostExe" Source="$(var.BinDir)\couchlink-host.exe" KeyPath="yes" />
          <ServiceInstall Id="Service"
                          Name="Couchlink"
                          DisplayName="Couchlink"
                          Description="Connects Steam Controllers from the Couchlink app on iPad and iPhone to Steam on this PC."
                          Type="ownProcess"
                          Start="auto"
                          ErrorControl="normal"
                          Account="LocalSystem"
                          Arguments="service"
                          Vital="yes" />
          <ServiceControl Id="ServiceControl" Name="Couchlink" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          <!-- The link port, from the local network and Tailscale only. -->
          <fire:FirewallException Id="LinkPort"
                                  Name="Couchlink (UDP 48150)"
                                  Description="Controller input from the Couchlink app on iPad and iPhone."
                                  Program="[#HostExe]"
                                  Protocol="udp"
                                  Port="48150"
                                  Profile="all">
            <fire:RemoteAddress Value="LocalSubnet" />
            <fire:RemoteAddress Value="100.64.0.0/10" />
            <fire:RemoteAddress Value="fd7a:115c:a1e0::/48" />
          </fire:FirewallException>
          <!-- So 'couchlink-host clients', 'demo' etc. work in any terminal. -->
          <Environment Id="Path" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
        </Component>
        <Component Id="Notices">
          <File Id="License" Source="$(var.RootDir)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
          <File Id="CoreLicense" Source="$(var.RootDir)\core\LICENSE" Name="LICENSE-MIT.txt" />
          <File Id="ThirdParty" Source="$(var.RootDir)\THIRD_PARTY_NOTICES.md" Name="THIRD_PARTY_NOTICES.txt" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Couchlink">
      <ComponentRef Id="Host" />
      <ComponentRef Id="Notices" />
    </Feature>

    <!--
      Before the files go in: stop a copy set up with 'couchlink-host install'
      (logon task, firewall rule, running process), and bring its pairings
      along from the installing user's profile. Errors are ignored: on a fresh
      PC there is nothing to clean up.
    -->
    <SetProperty Id="RemoveLegacyInstall"
                 Sequence="execute"
                 Before="RemoveLegacyInstall"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Unregister-ScheduledTask -TaskName Couchlink -Confirm:$false -ErrorAction SilentlyContinue; Get-Process couchlink-host -ErrorAction SilentlyContinue | Stop-Process -Force; Remove-NetFirewallRule -DisplayName Couchlink -ErrorAction SilentlyContinue; $src = '[AppDataFolder]Couchlink\couchlink-host.conf'; $dir = '[CommonAppDataFolder]Couchlink\pairing'; $dst = Join-Path $dir 'couchlink-host.conf'; (Test-Path $src) -and -not (Test-Path $dst) -and (New-Item -ItemType Directory -Force -Path $dir) -and (Copy-Item $src $dst -PassThru) | Out-Null; exit 0&quot;" />
    <CustomAction Id="RemoveLegacyInstall"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="RemoveLegacyInstall" After="StopServices" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RootDir)\installer\windows\License.rtf" />
  </Package>
</Wix>
